{
 "builtIns": [
  {
   "type": "physics",
   "label": "Physics",
   "description": "Creates a rigid body. Mass 0 is static; colliders are authored separately from render meshes.",
   "category": "Physics",
   "fields": [
    {
     "name": "shape",
     "kind": "choice",
     "choices": [
      "box",
      "sphere",
      "plane"
     ],
     "required": true
    },
    {
     "name": "mass",
     "kind": "number",
     "unit": "kg",
     "min": 0,
     "step": 1,
     "default": 0,
     "description": "0 makes the body static; planes must be static."
    },
    {
     "name": "halfExtents",
     "kind": "vector3",
     "label": "half extents",
     "unit": "m",
     "min": 0,
     "minExclusive": true,
     "step": 0.25,
     "default": [
      0.5,
      0.5,
      0.5
     ],
     "when": {
      "field": "shape",
      "equals": [
       "box"
      ]
     }
    },
    {
     "name": "radius",
     "kind": "number",
     "unit": "m",
     "min": 0,
     "minExclusive": true,
     "step": 0.25,
     "default": 0.5,
     "when": {
      "field": "shape",
      "equals": [
       "sphere"
      ]
     },
     "description": "Spheres require uniform entity scale."
    },
    {
     "name": "friction",
     "kind": "number",
     "min": 0,
     "step": 0.05,
     "default": 0.5
    },
    {
     "name": "restitution",
     "kind": "number",
     "min": 0,
     "max": 1,
     "step": 0.05,
     "default": 0
    },
    {
     "name": "linearDamping",
     "kind": "number",
     "label": "linear damping",
     "min": 0,
     "max": 1,
     "step": 0.01,
     "default": 0.01
    },
    {
     "name": "angularDamping",
     "kind": "number",
     "label": "angular damping",
     "min": 0,
     "max": 1,
     "step": 0.01,
     "default": 0.1
    }
   ],
   "presets": [
    {
     "id": "physics.box",
     "label": "Box Collider",
     "data": {
      "shape": "box",
      "mass": 0,
      "halfExtents": [
       0.5,
       0.5,
       0.5
      ]
     }
    },
    {
     "id": "physics.sphere",
     "label": "Sphere Collider",
     "data": {
      "shape": "sphere",
      "mass": 0,
      "radius": 0.5
     }
    }
   ]
  },
  {
   "type": "vehicle",
   "label": "Vehicle",
   "description": "Raycast suspension and drive on the physics body. Requires uniform entity scale.",
   "category": "Physics",
   "requires": [
    "physics"
