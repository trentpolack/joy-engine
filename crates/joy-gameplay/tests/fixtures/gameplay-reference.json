       "kind": "number",
       "label": "damping relaxation",
       "min": 0,
       "step": 0.1,
       "default": 2.3
      },
      {
       "name": "maxSuspensionTravel",
       "kind": "number",
       "label": "max suspension travel",
       "unit": "m",
       "min": 0,
       "step": 0.05,
       "default": 0.3
      },
      {
       "name": "maxSuspensionForce",
       "kind": "number",
       "label": "max suspension force",
       "unit": "N",
       "min": 0,
       "step": 100,
       "default": 100000
      },
      {
       "name": "frictionSlip",
       "kind": "number",
       "label": "friction slip",
       "min": 0,
       "step": 0.1,
