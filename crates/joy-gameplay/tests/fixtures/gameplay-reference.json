    {
     "name": "engineForce",
     "kind": "number",
     "label": "engine force",
     "unit": "N",
     "min": 0,
     "step": 10,
     "default": 400
    },
    {
     "name": "maxSteer",
     "kind": "number",
     "label": "max steer",
     "unit": "rad",
     "min": 0,
     "max": 1.5707963267948966,
     "step": 0.05,
     "default": 0.45
    },
    {
     "name": "brakeForce",
     "kind": "number",
     "label": "brake force",
     "unit": "N",
     "min": 0,
     "step": 1,
     "default": 20
    },
    {
     "name": "frictionSlip",
     "kind": "number",
     "label": "friction slip",
     "min": 0,
     "step": 0.1,
     "default": 5
    }
   ],
