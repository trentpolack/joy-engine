{
  "version": 1,
  "name": "FRAMEBREAK / blade arc",
  "maxParticles": 28,
  "parameters": {
    "scale": {
      "value": 1,
      "min": 0.1,
      "max": 8
    },
    "direction": {
      "type": "vector3",
      "value": [
        0,
        1,
        0
      ],
      "min": [
        -1,
        -1,
        -1
      ],
      "max": [
        1,
        1,
        1
      ]
    },
    "tint": {
      "type": "color",
      "value": [
        1,
        0.55,
        0.2,
        1
      ],
      "min": [
        0,
        0,
        0,
        0
      ],
      "max": [
        1,
        1,
        1,
        1
      ]
    }
  },
  "emitters": [
    {
      "id": "arc",
      "enabled": true,
      "root": true,
      "duration": 0,
      "rate": 0,
      "bursts": [
        {
          "time": 0,
          "count": 14
        }
      ],
      "lifetime": 0.3,
      "renderer": "soft",
      "spawn": "let a = (index / 14 - 0.5) * 2.4;\nlet side = vector(direction.z, 0, -direction.x);\nposition = origin + (direction * cos(a) + side * sin(a)) * 3.5 * scale + vector(0, rand(-0.3, 0.3), 0);\nsize = rand(0.7, 1.1) * scale;\nlifetime = rand(0.18, 0.32);\ncolor = rgba(tint.r * 9, tint.g * 9, tint.b * 9, 1);",
      "update": "size -= dt * 1.5;\ncolor.a = 1 - t;"
    },
    {
      "id": "embers",
      "enabled": true,
      "root": true,
      "duration": 0,
      "rate": 0,
      "bursts": [
        {
          "time": 0,
          "count": 10
        }
      ],
      "lifetime": 0.7,
      "renderer": "streak",
      "spawn": "velocity = direction * rand(4, 16) + vector(rand(-8, 8), rand(-2, 8), rand(-8, 8));\nposition = origin + direction * rand(1, 4) * scale;\nsize = rand(0.04, 0.09);\nlifetime = rand(0.3, 0.7);\ncolor = rgba(tint.r * 8, tint.g * 8, tint.b * 8, 1);",
      "update": "acceleration.y = -14;\ndrag = 1.2;\ncolor.a = 1 - t;"
    }
  ]
}
