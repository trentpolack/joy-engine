{
 "builtIns": [
  {
   "type": "render",
   "label": "Render",
   "description": "Draws a primitive shape, or a FORM mesh when an asset is assigned. Entity scale multiplies size.",
   "category": "Rendering",
   "fields": [
    {
     "name": "asset",
     "kind": "asset",
     "label": "FORM mesh",
     "description": "Replaces the primitive shape with a compiled FORM or FORM LAB mesh.",
     "assetKinds": [
      "form",
      "formlab"
     ]
    },
    {
     "name": "variant",
     "kind": "text",
     "label": "Variant",
     "description": "A FORM LAB document's named variant, applied beneath the parameter overrides."
    },
    {
     "name": "parameters",
     "kind": "record",
     "description": "FORM parameter overrides; omitted parameters use the script defaults."
    },
    {
     "name": "shape",
     "kind": "choice",
     "choices": [
      "box",
      "sphere"
     ],
     "description": "Primitive drawn when no FORM mesh is assigned."
    },
    {
     "name": "size",
     "kind": "vector3",
     "unit": "m",
     "step": 0.25,
     "default": [
      1,
      1,
      1
     ],
     "description": "Full primitive dimensions before entity scale."
    },
    {
     "name": "color",
     "kind": "color",
     "min": 0,
     "description": "Linear RGB tint. Omitted, primitives draw orange and FORM meshes keep their own colors."
    }
   ],
   "presets": [
    {
     "id": "render.primitive",
     "label": "Primitive",
     "data": {
      "shape": "box",
      "size": [
       1,
       1,
       1
      ],
      "color": [
       0.93,
       0.42,
       0.22
      ]
     }
    },
    {
     "id": "render.mesh",
     "label": "FORM Mesh",
     "data": {
      "asset": "",
      "parameters": {}
     }
    }
   ]
  },
  {
   "type": "light",
   "label": "Point Light",
   "description": "Illuminates the scene from the entity position. Rotation and scale are ignored.",
   "category": "Lighting",
   "fields": [
    {
     "name": "enabled",
     "kind": "boolean",
     "default": true
    },
    {
     "name": "color",
     "kind": "color",
     "min": 0,
     "default": [
      1,
      1,
      1
     ],
     "description": "Linear RGB before intensity."
    },
    {
     "name": "intensity",
     "kind": "number",
     "unit": "linear",
     "min": 0,
     "step": 0.25,
     "default": 1
    },
    {
     "name": "range",
     "kind": "number",
     "unit": "m",
     "min": 0,
     "minExclusive": true,
     "step": 0.5,
     "default": 10
    },
    {
     "name": "castsShadow",
     "kind": "boolean",
     "label": "casts shadow",
     "default": true
    }
   ],
   "presets": [
    {
     "id": "light.point",
     "label": "Point Light",
     "data": {
      "enabled": true,
      "color": [
       1,
       0.88,
       0.7
      ],
      "intensity": 4,
      "range": 12,
      "castsShadow": true
     }
    }
   ]
  },
  {
   "type": "effect",
   "label": "Particle Effect",
   "description": "Plays a JOYFX effect attached to the entity transform.",
   "category": "Effects",
   "fields": [
    {
     "name": "asset",
     "kind": "asset",
     "label": "JOYFX effect",
     "required": true,
     "assetKinds": [
      "joyfx"
     ]
    },
    {
     "name": "enabled",
     "kind": "boolean",
     "default": true
    },
    {
     "name": "loop",
     "kind": "boolean",
     "default": false,
     "description": "Restart once every particle has expired."
    },
    {
     "name": "seed",
     "kind": "number",
     "integer": true,
     "step": 1,
     "default": 7777
    },
    {
     "name": "parameters",
     "kind": "record",
     "description": "Effect parameter overrides; omitted parameters use the effect defaults."
    }
   ],
   "presets": [
    {
