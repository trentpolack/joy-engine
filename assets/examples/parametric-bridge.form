# PARAMETRIC BRIDGE
project meta(name="Parametric bridge", info="RUNTIME RECIPE / 001", title="GIVE AN IDEA SOME ROOM.")

# The editor and a game supply these same inputs.
param start = vector(-8, 2, 0) meta(min=-20, max=20, step=0.1)
param end = vector(8, 2, 0) meta(min=-20, max=20, step=0.1)
param count = 24 meta(min=4, max=64, step=1)
param width = 3 meta(min=1, max=6, step=0.1)
param sag = 2 meta(min=0, max=6, step=0.1)
param variation = 0.08 meta(min=0, max=0.4, step=0.01)
param random_seed = 42 meta(min=1, max=9999, step=1)
param tint = rgba(0.93, 0.42, 0.22, 1)
param plank = meshBox(1, 0.18, 1)
param finish = materialPbr(tint, 0.15, 0.55)

seed(random_seed)

# ---- Span.
# White vertices, so the finish's color shows as authored.
const white = rgba(1, 1, 1, 1)
const dx = end.x - start.x
const dz = end.z - start.z
const span = sqrt(dx*dx + dz*dz)
const heading = -atan2(dz, dx)

# ---- Deck.
# Planks hang along a sine sag between the endpoints, each tilted to the curve's slope with a little random wobble.
# Every plank's faces record its index and position along the span (0 at start, 1 at end) for a game to read.
let deck = geometry()
for i in 0..count {
  const t = i / (count - 1)
  const px = mix(start.x, end.x, t)
  const py = mix(start.y, end.y, t) - sin(t*pi)*sag
  const pz = mix(start.z, end.z, t)
  const slope = atan2(end.y - start.y - cos(t*pi)*pi*sag, max(span, 0.01))
  let board = place(plank, vector(px, py, pz),
    vector((rand() - 0.5)*variation, heading, slope),
    vector(max(span, 0.1)/count*0.9, 1, width))
  addAttribute(board, "faces", "kind", "bridge-plank")
  addAttribute(board, "faces", "index", i)
  addAttribute(board, "faces", "spanPosition", t)
  append(deck, board)
}

# ---- Supports.
# Reusable geometry can also be deformed before placing: this post rises from its base.
const support = deform(meshBox(0.35, 3, 0.35), x, y + 1.5, z)

# A post at one end of the bridge; `endpoint` is "start" or "end".
fn post(position, endpoint) {
  let part = place(support, position)
  addAttribute(part, "faces", "kind", "bridge-support")
  addAttribute(part, "faces", "endpoint", endpoint)
  return part
}

const supports = merge(post(start, "start"), post(end, "end"))

output("Parametric bridge", material(color(merge(deck, supports), white), finish))
