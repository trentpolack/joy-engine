# ORBITAL BLOOM
project meta(name="Orbital bloom", info="POINT CLOUD / 002", title="POINTS OF POSSIBILITY.")

param count = 16000 meta(min=1000, max=20000, step=1000)
param radius = 8 meta(min=2, max=14, step=0.1)
param ripple = 0.8 meta(min=0, max=3, step=0.1)

# ---- Palette.
# Colors are graded by `warm`, FORM's classic tint: red at the top of the bloom, dusky rose at the bottom.
let warm = rgba(0.929, 0.424, 0.224, 1)

# ---- Bloom.
# A Fibonacci sphere: each point turns by the golden angle and steps down in height, so the points spread evenly.
# The radius ripples with the angle, and color shifts as the points descend.
let golden_angle = 2.399963
let bloom = geometry()
repeat count as i {
  let t = i/count
  let y = 1 - 2*t
  let angle = i*golden_angle
  let ring = sqrt(1 - y*y)
  let r = radius + sin(angle*0.04)*ripple
  let shade = rgba(1 - t*0.5, 0.35 + t*0.4, 0.2 + t*0.6, 1)*warm
  addPoint(bloom, vector(cos(angle)*ring*r, y*radius, sin(angle)*ring*r), {color: shade})
}

# The first point describes the whole cloud for hosts that read the output.
addAttribute(bloom, "points", "kind", "")
addAttribute(bloom, "points", "pointCount", 0)
setAttribute(bloom, "points", "kind", 0, "orbit")
setAttribute(bloom, "points", "pointCount", 0, count)

output("Bloom", bloom)
