# WAVE STUDY
project meta(name="Wave study", info="SURFACE STUDY / 001", title="MAKE SOME WAVES.")

# A little math. A little landscape.
param height = 2.4 meta(min=0, max=5, step=0.1)
param frequency = 0.55 meta(min=0.1, max=1.5, step=0.05)
param resolution = 64 meta(min=8, max=120, step=1)
param tint = rgba(0.93, 0.42, 0.22, 1)

# ---- Palette.
const accent_color = rgba(1, 0.82, 0.4, 1)

# ---- Wave.
# The landscape's height at any X/Z position; the surface and the points above it share it.
fn wave(x, z) {
  return sin(x*frequency)*cos(z*frequency)*height
}

# ---- Surface.
# A flat grid lifted into the wave.
let surface = grid(resolution, resolution, 24, 24)
wrangle points in surface as element {
  let position = element.position
  element.position = vector(position.x, wave(position.x, position.z), position.z)
}
addAttribute(surface, "points", "kind", "terrain")
addAttribute(surface, "points", "study", "wave")
color(surface, tint)

# ---- Accents.
# A scattering of warm points above the surface.
seed(19)
let accents = geometry()
for i in 0..500 {
  const px = (rand() - 0.5)*24
  const pz = (rand() - 0.5)*24
  addPoint(accents, vector(px, wave(px, pz) + 0.18, pz), {kind: "accent", study: "wave"})
}
color(accents, accent_color)

output("Wave study", merge(surface, accents))
