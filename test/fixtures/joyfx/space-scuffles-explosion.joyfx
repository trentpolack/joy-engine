{
  "version": 1,
  "name": "SPACE SCUFFLES / Traveling detonation",
  "maxParticles": 768,
  "parameters": {
    "power": {
      "value": 1,
      "min": 0.1,
      "max": 20
    },
    "stone": {
      "value": 0,
      "min": 0,
      "max": 1
    }
  },
  "emitters": [
    {
      "id": "flash",
      "enabled": true,
      "root": true,
      "duration": 0,
      "rate": 0,
      "bursts": [
        {
          "time": 0,
          "count": 1
        }
      ],
      "lifetime": 0.085,
      "renderer": "soft",
      "spawn": "size = 42 * power; z = 41; r = 9; g = 6; b = 2;",
      "update": "size = 42 * power * (1 - t); alpha = 1 - t;"
    },
    {
      "id": "core",
      "enabled": true,
      "root": true,
      "duration": 0,
      "rate": 0,
      "bursts": [
        {
          "time": 0,
          "count": 1
        }
      ],
      "lifetime": 0.65,
      "renderer": "billow",
      "spawn": "size = 12 * power; z = 32; rotation = rand(0, tau); r = mix(3.5, 1.7, stone); g = mix(0.8, 1.8, stone); b = mix(0.04, 2.1, stone);",
      "update": "size = power * (12 + 72 * (1 - exp(-age * 25))); alpha = clamp((1 - t) * 3, 0, 1); r = mix(4, 0.3, t); g = mix(1.1, 0.08, t); b = mix(0.05, 0.03, t); if(stone > 0.5) { r = mix(2, 0.12, t); g = r * 1.05; b = r * 1.2; }"
    },
    {
      "id": "lobes",
      "enabled": true,
      "root": true,
      "duration": 0.08,
      "rate": 0,
      "bursts": [
        {
          "time": 0,
          "count": 8
        },
        {
          "time": 0.05,
          "count": 5
        }
      ],
      "lifetime": 0.68,
      "renderer": "billow",
      "spawn": "let angle = rand(0, tau); let speed = rand(90, 190) * power; vx = cos(angle) * speed; vy = sin(angle) * speed; u0 = rand(18, 30) * power; size = u0 * 0.3; rotation = angle; spin = rand(-1, 1); drag = 1.8; z = 33 + rand(0, 0.8); r = mix(3.5, 1.7, stone); g = mix(0.8, 1.8, stone); b = mix(0.04, 2.1, stone);",
      "update": "size = u0 * (0.3 + (1 - exp(-age * 20)) * 1.5); alpha = clamp((1 - t) * 2.5, 0, 1); r = mix(3.5, 0.3, t); g = mix(0.65, 0.035, t); b = 0.015; if(stone > 0.5) { r = mix(1.6, 0.13, t); g = r * 1.05; b = r * 1.2; }"
    },
    {
      "id": "shock",
      "enabled": true,
      "root": true,
      "duration": 0,
      "rate": 0,
      "bursts": [
        {
          "time": 0,
          "count": 1
        }
      ],
      "lifetime": 0.3,
      "renderer": "ring",
      "spawn": "size = 8 * power; z = 40; r = mix(3.5, 1.7, stone); g = mix(0.8, 1.8, stone); b = mix(0.04, 2.1, stone);",
      "update": "size = power * (8 + 230 * sqrt(t)); alpha = (1 - t) ^ 2;"
    },
    {
      "id": "sparks",
      "enabled": true,
      "root": true,
      "duration": 0,
      "rate": 0,
      "bursts": [
        {
          "time": 0,
          "count": 32
        }
      ],
      "lifetime": 0.6,
      "renderer": "streak",
      "spawn": "let angle = rand(0, tau); let speed = rand(400, 1100) * sqrt(power); vx = cos(angle) * speed; vy = sin(angle) * speed; size = rand(1, 2.5) * sqrt(power); lifetime = rand(0.3, 0.65); drag = 1.1; z = 36; r = mix(3.5, 1.7, stone); g = mix(0.8, 1.8, stone); b = mix(0.04, 2.1, stone);",
      "update": "alpha = (1 - t) ^ 0.5;"
    },
    {
      "id": "fragments",
      "enabled": true,
      "root": true,
      "duration": 0,
      "rate": 0,
      "bursts": [
        {
          "time": 0,
          "count": 6
        }
      ],
      "lifetime": 1.15,
      "renderer": "streak",
      "spawn": "let angle = rand(0, tau); let speed = rand(650, 950) * sqrt(power); vx = cos(angle) * speed; vy = sin(angle) * speed; lifetime = rand(0.8, 1.25); size = rand(3, 5) * sqrt(power); u0 = rand(-1.8, 1.8); drag = 0.42; z = 35; r = mix(3.5, 1.7, stone); g = mix(0.8, 1.8, stone); b = mix(0.04, 2.1, stone);",
      "update": "let speed = sqrt(vx * vx + vy * vy); let angle = atan2(vy, vx) + u0 * dt; vx = cos(angle) * speed; vy = sin(angle) * speed; alpha = clamp((1 - t) * 4, 0, 1);",
      "trail": {
        "emitter": "smoke",
        "interval": 0.05,
        "count": 1
      },
      "death": {
        "emitter": "secondary",
        "count": 1
      }
    },
    {
      "id": "smoke",
      "enabled": true,
      "root": false,
      "duration": 0,
      "rate": 0,
      "bursts": [],
      "lifetime": 1.3,
      "renderer": "billow",
      "spawn": "vx = parentVx * 0.06 + rand(-12, 12); vy = parentVy * 0.06 + rand(-12, 12); u0 = rand(10, 18) * sqrt(power); size = u0; rotation = rand(0, tau); spin = rand(-1, 1); drag = 1.6; z = 24; r = 2.4; g = 0.3; b = 0.015; u1 = rand(0, 10);",
      "update": "size = u0 * (1 + t * 1.6); ax = noise(time * 1.7 + u1) * 18; ay = noise(time * 1.3 + u1 + 40) * 18; alpha = 0.42 * clamp((1 - t) * 3, 0, 1); let cooling = clamp(age * 7, 0, 1); r = mix(2.4, 0.12, cooling); g = mix(0.3, 0.09, cooling); b = mix(0.015, 0.07, cooling); if(stone > 0.5) { r = mix(0.7, 0.14, cooling); g = r; b = r * 1.15; }"
    },
    {
      "id": "secondary",
      "enabled": true,
      "root": false,
      "duration": 0,
      "rate": 0,
      "bursts": [],
      "lifetime": 0.5,
      "renderer": "billow",
      "spawn": "vx = parentVx * 0.08; vy = parentVy * 0.08; size = 4; rotation = rand(0, tau); z = 36; r = mix(3.5, 1.7, stone); g = mix(0.8, 1.8, stone); b = mix(0.04, 2.1, stone);",
      "update": "size = sqrt(power) * (4 + 30 * (1 - exp(-age * 35))); alpha = clamp((1 - t) * 3, 0, 1); r = mix(5, 0.5, t); g = mix(1.7, 0.06, t); b = 0.02; if(stone > 0.5) { g = r; b = r * 1.1; }",
      "trail": {
        "emitter": "secondary_sparks",
        "interval": 0.1,
        "count": 3
      }
    },
    {
      "id": "secondary_sparks",
      "enabled": true,
      "root": false,
      "duration": 0,
      "rate": 0,
      "bursts": [],
      "lifetime": 0.35,
      "renderer": "streak",
      "spawn": "let angle = rand(0, tau); vx = cos(angle) * rand(120, 300) + parentVx; vy = sin(angle) * rand(120, 300) + parentVy; size = 1.2 * sqrt(power); drag = 1.8; z = 37; r = mix(3.5, 1.7, stone); g = mix(0.8, 1.8, stone); b = mix(0.04, 2.1, stone);",
      "update": "alpha = 1 - t;"
    }
  ]
}
