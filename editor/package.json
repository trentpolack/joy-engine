{
  "name": "@joy-games/joy-editor",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Local browser and desktop authoring workspace for Joy Engine games.",
  "author": "Trent Polack",
  "license": "MIT",
  "exports": {
    "./tooling/policy": "./tooling/editor-policy.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "cargo run --package joy-editor",
    "build": "node ../scripts/rust/build-web.mjs --package joy-editor --release --title \"Joy Editor\" --canvas joy-editor --out dist",
    "preview": "node ../scripts/preview-web.mjs",
    "check": "cargo check --package joy-editor --all-targets",
    "test": "cargo test --package joy-editor && node --test test/*.test.mjs",
    "capture": "node ../scripts/capture-web.mjs"
  },
  "dependencies": {
    "joy-engine": "file:.."
  }
}
