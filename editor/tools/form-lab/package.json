{
  "name": "@joy-games/form-lab",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "gameSite": {
    "category": "app",
    "title": "FORM LAB",
    "description": "A little language. A lot of possibilities. Script geometry and point clouds with a live Joy Engine viewport.",
    "status": "Creative tool",
    "accent": "#ed6c39",
    "startedAt": "2026-09-14",
    "screenshot": "form-lab.png"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "check": "joy-check-javascript src site test && tsc --project tsconfig.json",
    "test": "node --import joy-engine/testing/register-raw-loader --test test/*.test.js",
    "capture": "node test/browser.mjs",
    "test:worker-browser": "node test/worker-budget-browser.mjs",
    "test:viewport-browser": "node test/viewport-browser.mjs",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:pack": "npm run build && electron-packager . \"Form Lab\" --out=release --overwrite --ignore=\"^/(site|test|release)$\""
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@joy-games/joy-editor": "file:../..",
    "joy-engine": "file:../../.."
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^44.5.1"
  },
  "description": "Live procedural geometry and point scripting with Joy Engine.",
  "author": "Trent Polack",
  "license": "MIT"
}
