{
  "version": 1,
  "name": "Prism Sprite Garden",
  "maxParticles": 128,
  "parameters": {},
  "emitters": [
    {
      "enabled": true,
      "root": true,
      "duration": 5,
      "rate": 4,
      "bursts": [
        {
          "time": 0,
          "count": 1
        }
      ],
      "lifetime": 1.5,
      "id": "circle",
      "renderer": "circle",
      "spawn": "position = origin + vector(-138.0, rand(-8, 8), rand(-14, 14));\nvelocity = vector(0, rand(26, 42), 0); size = 19;\nrotation = rand(-0.3, 0.3); spin = 0.6;\ncolor = rgba(0.25, 1.8, 2.4, 1);",
      "update": "size += 7 * dt; color.a = 1 - smoothstep(0.5, 1, t);"
    },
