{
  "name": "joy-engine",
  "version": "1.0.0",
  "private": true,
  "description": "A game engine built in Rust for making cross-platform games; the engine is intended for prototyping, procedural generation, and other things that seem fun.",
  "author": "Trent Polack",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trentpolack/joy-engine.git"
  },
  "workspaces": [
    "examples/*",
    "editor",
    "tools/*"
  ],
  "exports": {
    "./development/patches": "./scripts/patching/index.mjs",
    "./form/catalog": "./scripts/form-reference.mjs",
    "./schemas/*": "./schemas/*",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "joy-check-javascript": "scripts/check-javascript.mjs"
  },
  "files": [
    "schemas",
    "scripts",
    "tsconfig.base.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "cargo +nightly fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && node scripts/check-boundaries.mjs && node scripts/check-javascript.mjs scripts tests/tooling editor/tooling editor/tests/tooling tools/form-editor/tests/tooling",
    "test": "cargo test --workspace && npm run test:tooling",
    "test:tooling": "node --test tests/tooling/*.test.mjs editor/tests/tooling/*.test.mjs",
    "fetch-joy-engine-patch": "node scripts/patching/fetch-joy-engine-patch.mjs",
    "apply-joy-engine-patch": "node scripts/patching/apply-joy-engine-patch.mjs",
    "docs:api": "cargo doc --workspace --no-deps",
    "build:web": "node scripts/rust/build-web.mjs",
    "audit:repo": "python3 -B scripts/audit/audit.py",
    "test:audit": "python3 -B tests/tooling/test_audit.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.2"
  }
}
