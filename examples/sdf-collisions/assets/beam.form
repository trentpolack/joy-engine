# I-BEAM: two flanges joined by a web. Flanges nest into each other's channels when beams stack.
project meta(name="I-beam", info="SDF COLLISIONS / PROP")

param length = 1.1 meta(min=0.4, max=2, step=0.05)
param flange = 0.42 meta(min=0.2, max=0.8, step=0.02)
param depth = 0.42 meta(min=0.2, max=0.8, step=0.02)
param plate = 0.07 meta(min=0.03, max=0.15, step=0.01)

# ---- Finish.
# White vertices, so the material's base color shows as authored.
const white = rgba(1, 1, 1, 1)
const finish = materialPbr(rgba(0.5, 0.64, 0.9, 1), 0.15, 0.45)

# ---- Parts.
const unit = meshBox(1, 1, 1)

# An axis-aligned box: the unit mesh placed at `center` and stretched to `size`.
fn block(center, size) {
  return place(unit, center, vector(0, 0, 0), size)
}

let flanges = geometry()
for side in 0..2 {
  const y = (side*2 - 1)*(depth/2 - plate/2)
  append(flanges, block(vector(0, y, 0), vector(length, plate, flange)))
}
const web = block(vector(0, 0, 0), vector(length, depth - plate*2, plate))

output("I-beam", material(color(merge(flanges, web), white), finish))
