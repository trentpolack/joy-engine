# JACK: three crossed bars with blocky end caps. Every orientation lands on a different set of arms.
project meta(name="Jack", info="SDF COLLISIONS / PROP")

param span = 1 meta(min=0.4, max=1.6, step=0.05)
param bar = 0.14 meta(min=0.06, max=0.3, step=0.01)
param cap = 0.24 meta(min=0.1, max=0.4, step=0.01)

# ---- Finish.
# White vertices, so the material's base color shows as authored.
const white = rgba(1, 1, 1, 1)
const finish = materialPbr(rgba(0.3, 0.86, 0.82, 1), 0.05, 0.45)

# ---- Parts.
const unit = meshBox(1, 1, 1)
const reach = span/2 - cap/2
const arm = span - cap

# An axis-aligned box: the unit mesh placed at `center` and stretched to `size`.
fn block(center, size) {
  return place(unit, center, vector(0, 0, 0), size)
}

# One bar along each axis, crossing at the center.
const bars = merge(
  block(vector(0, 0, 0), vector(arm, bar, bar)),
  block(vector(0, 0, 0), vector(bar, arm, bar)),
  block(vector(0, 0, 0), vector(bar, bar, arm))
)

# A cube cap on both ends of every bar.
let caps = geometry()
const cap_size = vector(cap, cap, cap)
for side in 0..2 {
  const sign = side*2 - 1
  append(caps, block(vector(sign*reach, 0, 0), cap_size))
  append(caps, block(vector(0, sign*reach, 0), cap_size))
  append(caps, block(vector(0, 0, sign*reach), cap_size))
}

output("Jack", material(color(merge(bars, caps), white), finish))
