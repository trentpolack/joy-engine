# JACK: three crossed bars with blocky end caps. Every orientation lands on a different set of arms.
project meta(name="Jack", info="SDF COLLISIONS / PROP")

param span = 1 meta(min=0.4, max=1.6, step=0.05)
param bar = 0.14 meta(min=0.06, max=0.3, step=0.01)
param cap = 0.24 meta(min=0.1, max=0.4, step=0.01)

# White vertices, so the material's base color shows as authored.
color(1, 1, 1)
let unit = meshBox(1, 1, 1)
let finish = materialPbr(rgba(0.3, 0.86, 0.82, 1), 0.05, 0.45)
let reach = span/2 - cap/2

instance(unit, vector(0, 0, 0), vector(0, 0, 0), vector(span - cap, bar, bar), finish)
instance(unit, vector(0, 0, 0), vector(0, 0, 0), vector(bar, span - cap, bar), finish)
instance(unit, vector(0, 0, 0), vector(0, 0, 0), vector(bar, bar, span - cap), finish)
repeat 2 as side {
  let sign = side*2 - 1
  instance(unit, vector(sign*reach, 0, 0), vector(0, 0, 0), vector(cap, cap, cap), finish)
  instance(unit, vector(0, sign*reach, 0), vector(0, 0, 0), vector(cap, cap, cap), finish)
  instance(unit, vector(0, 0, sign*reach), vector(0, 0, 0), vector(cap, cap, cap), finish)
}
