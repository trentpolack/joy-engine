# RING: the render mesh of the analytical torus collider (major radius 0.36, minor radius 0.1). Its collider is
# an exact distance function, so this mesh never feeds physics.
project meta(name="Ring", info="SDF COLLISIONS / PROP")

param major = 0.36 meta(min=0.2, max=0.8, step=0.01)
param minor = 0.1 meta(min=0.03, max=0.3, step=0.01)
param detail = 40 meta(min=12, max=64, step=4)

# ---- Palette.
# The ring's rose is graded by `warm`, FORM's classic tint, which gives the prop its deep red.
let warm = rgba(0.929, 0.424, 0.224, 1)
let ring_color = rgba(0.86, 0.3, 0.44, 1)*warm

# ---- Profile.
# A closed circle of the minor radius, offset by the major radius, then swept around Y.
let profile = geometry()
repeat 17 as i {
  let angle = i/16*tau
  addPoint(profile, vector(major + cos(angle)*minor, sin(angle)*minor, 0))
}
let ring = color(revolve(profile, detail), ring_color)

output("Ring", smoothNormals(ring))
