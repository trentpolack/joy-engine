project meta(name="Building shell", info="FORM RUNTIME ASSET / METERS / Y-UP")
param width = 8 meta(min=4, max=30, step=0.25)
param depth = 6 meta(min=4, max=30, step=0.25)
param height = 6 meta(min=3, max=30, step=0.25)
param floors = 2 meta(min=1, max=8, step=1)
param window_spacing = 2 meta(min=1.5, max=6, step=0.25)
param door_spacing = 6 meta(min=3, max=12, step=0.25)
param roof_shape = 1 meta(min=0, max=1, step=1)
param roof_rise = 2 meta(min=0.3, max=5, step=0.1)
param random_seed = 42 meta(min=1, max=9999, step=1)
param wall_tint = rgba(0.66,0.48,0.3,1)
param roof_tint = rgba(0.19,0.25,0.3,1)
param wall_finish = materialPbr(wall_tint,0,0.85)
param roof_finish = materialPbr(roof_tint,0.1,0.55)
param window_piece = meshBox(1,1,0.12)

seed(random_seed)

# ---- Finishes.
# White vertices, so each material's base color shows as authored; window panes add a random cool tint.
const white = rgba(1,1,1,1)
const trim = materialPbr(rgba(0.12,0.16,0.19,1),0,0.7)
const glass = materialPbr(rgba(0.16,0.46,0.58,1),0.3,0.2)

# ---- Proportions.
const unit = meshBox(1,1,1)
const floor_count = floor(floors)
const floor_height = height/floor_count
const window_height = min(1.3,floor_height*0.55)
const columns = max(1,floor((width - 1)/window_spacing))
const side_columns = max(1,floor((depth - 1)/window_spacing))
const doors = max(1,floor(width/door_spacing))
const no_turn = vector(0,0,0)
const quarter_turn = vector(0,pi/2,0)

# ---- Helpers.
# A white box: the unit mesh placed at `center`, turned by `rotation`, stretched to `size`, and given `finish`.
fn block(center, rotation, size, finish) {
  return material(color(place(unit,center,rotation,size),white),finish)
}

# A trim frame with a tinted glass pane standing just proud of it.
fn window(frame_center, pane_center, rotation) {
  const frame = block(frame_center,rotation,vector(1.25,window_height + 0.18,0.18),trim)
  const pane_tint = rgba(0.7 + rand()*0.3,0.7 + rand()*0.3,1,1)
  let pane = place(window_piece,pane_center,rotation,vector(1,window_height,1))
  return merge(frame,material(color(pane,pane_tint),glass))
}

# A door with its canopy. Every face records its entrance: `kind`, the door `index`, and the `doorstep` where the
# door meets the ground (`position` is reserved for point positions).
fn entrance(index, x) {
  const door_height = min(2.2,floor_height*0.8)
  const door = block(vector(x,door_height/2,depth/2 + 0.16),no_turn,vector(1.4,door_height,0.15),trim)
  const canopy = block(vector(x,door_height + 0.2,depth/2 + 0.5),no_turn,vector(2,0.14,0.9),roof_finish)
  let parts = merge(door,canopy)
  addAttribute(parts,"faces","kind","entrance")
  addAttribute(parts,"faces","index",index)
  addAttribute(parts,"faces","doorstep",vector(x,0,depth/2))
  return parts
}

# ---- Walls.
# Four walls leave a hollow interior; facade panels are decorative, not cut openings.
let walls = merge(
  block(vector(0,height/2,-depth/2),no_turn,vector(width,height,0.2),wall_finish),
  block(vector(0,height/2,depth/2),no_turn,vector(width,height,0.2),wall_finish)
)
for side in 0..2 {
  const sign = side*2 - 1
  append(walls,block(vector(sign*width/2,height/2,0),no_turn,vector(0.2,height,depth),wall_finish))
}

# ---- Floor bands.
# Floor bands and foundations are also reused boxes, not a host geometry generator.
let bands = geometry()
for level in 0..floor_count + 1 {
  append(bands,block(vector(0,level*floor_height,0),no_turn,vector(width + 0.3,0.16,depth + 0.3),trim))
}

# ---- Windows.
let windows = geometry()
for level in 0..floor_count {
  const y = (level + 0.5)*floor_height
  for side in 0..2 {
    const sign = side*2 - 1
    const front = side == 1
    for column in 0..columns {
      const x = (column - (columns - 1)/2)*window_spacing
      # Ground front is reserved for doors, avoiding overlapped panels.
      if level > 0 OR NOT front {
        append(windows,window(vector(x,y,sign*(depth/2 + 0.15)),vector(x,y,sign*(depth/2 + 0.26)),no_turn))
      }
    }
    for column in 0..side_columns {
      const z = (column - (side_columns - 1)/2)*window_spacing
      append(windows,window(vector(sign*(width/2 + 0.15),y,z),vector(sign*(width/2 + 0.26),y,z),quarter_turn))
    }
  }
}

# ---- Entrances.
let entrances = geometry()
for door in 0..doors {
  append(entrances,entrance(door,(door - (doors - 1)/2)*door_spacing))
}

# ---- Roof.
# roof_shape 0 is a flat slab; 1 is a gable of two pitched panels with triangular wall ends.
let roof = geometry()
if roof_shape < 0.5 {
  append(roof,block(vector(0,height + 0.25,0),no_turn,vector(width + 0.7,0.35,depth + 0.7),roof_finish))
} else {
  const half = width/2 + 0.35
  const slope = atan2(roof_rise,half)
  const length = sqrt(half*half + roof_rise*roof_rise)
  for side in 0..2 {
    const sign = side*2 - 1
    append(roof,block(vector(sign*half/2,height + roof_rise/2,0),vector(0,0,-sign*slope),vector(length,0.2,depth + 0.7),roof_finish))
  }
  let gables = geometry()
  addFace(gables,addPoint(gables,vector(-width/2,height,depth/2)),addPoint(gables,vector(width/2,height,depth/2)),addPoint(gables,vector(0,height + roof_rise,depth/2)))
  addFace(gables,addPoint(gables,vector(width/2,height,-depth/2)),addPoint(gables,vector(-width/2,height,-depth/2)),addPoint(gables,vector(0,height + roof_rise,-depth/2)))
  append(roof,material(color(gables,white),wall_finish))
}

output("Building",merge(walls,bands,windows,entrances,roof))
