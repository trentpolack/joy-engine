{
  "name": "@joy-engine/example-terrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Trent Polack",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "rust:web": "node ../../scripts/rust/build-web.mjs --example terrain --release --title \"TERRAIN · Joy Engine\"",
    "preview": "vite preview --host 127.0.0.1",
    "check": "joy-check-javascript src site test && tsc --project tsconfig.json",
    "capture": "node test/browser.mjs",
    "test": "node --import joy-engine/testing/register-raw-loader --test test/*.test.mjs"
  },
  "dependencies": {
    "joy-engine": "file:../.."
  },
  "gameSite": {
    "category": "example",
    "title": "TERRAIN",
    "description": "Explore continuous terrain detail, fly controls, and GPU selection.",
    "status": "Engine example",
    "accent": "#91ba80",
    "startedAt": "2026-10-02",
    "screenshot": "example-terrain.png"
  }
}
