{"version":2,"name":"Variant study","source":"project meta(name=\"Variant study\", info=\"FORM EDITOR / VARIANTS / MAPS\", title=\"ONE SCRIPT. MANY TAKES.\")\nparam columns = 4 meta(min=1, max=8, step=1)\nparam height = 2 meta(min=0.5, max=6, step=0.1)\nparam tint = rgba(0.9, 0.55, 0.3, 1)\nparam finish = materialPbr(rgba(0.3, 0.6, 0.8, 1), 0.8, 0.3)\n\n# ---- Palette.\nlet white = rgba(1, 1, 1, 1)\n\n# Document materials: a textured floor and a masked lattice that casts shadows with holes.\nlet floor = material(color(grid(16, 16, 14, 10), white), \"Checker\")\nlet lattice = material(color(translate(sphere(1.4, 32), vector(0, 2.4, 1.6)), white), \"Lattice\")\n\n# Parameters drive the columns; variants keep different takes.\nlet pillars = geometry()\nrepeat columns as i {\n  let x = (i - (columns - 1)/2)*2.4\n  append(pillars, place(meshBox(1, height, 1), vector(x, height/2, -2)))\n}\nmaterial(color(pillars, tint), finish)\n\noutput(\"Floor\", floor)\noutput(\"Lattice\", lattice)\noutput(\"Pillars\", pillars)\n","overrides":{"columns":5},"materials":[{"name":"Default","baseColor":[1,1,1,1],"metallic":0,"roughness":1,"emissive":[0,0,0],"alphaMode":"OPAQUE","alphaCutoff":0.5,"textures":{"baseColor":null,"normal":null,"emissive":null,"metallic":null,"roughness":null,"ao":null}},{"name":"Checker","baseColor":[1,1,1,1],"metallic":0,"roughness":0.85,"emissive":[0,0,0],"alphaMode":"OPAQUE","alphaCutoff":0.5,"textures":{"baseColor":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAIAAAAlC+aJAAAAgklEQVR42u3XsQ2AIABFQXA4R2AGS0tGsGQOh3AES+dxAagolHCUhOaSH82Lz32F2tmPs3pfcvrV+yUMfgAAAAC+PXFN2xDf+9Z7EwIAAADo+w/oARMCAADQA3rAhAAAAPSAHjAhAAAAPaAHTAgAAEAP6AETAgAA0AN6wIQAAACmAbxisGIR83USZwAAAABJRU5ErkJggg==","normal":null,"emissive":null,"metallic":null,"roughness":null,"ao":null}},{"name":"Lattice","baseColor":[1,1,1,1],"metallic":0.2,"roughness":0.45,"emissive":[0,0,0],"alphaMode":"MASK","alphaCutoff":0.5,"textures":{"baseColor":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAYAAACqaXHeAAAAiUlEQVR42u3YsQ3AIAxFQcwYzMS4zMQasAHU4HObpDnpS9GLNccqh4vW4/T89e9rSX4AAAAAACDzxe2F3/8TTAAAAAAAAGT+D9ADTAAAAAAAAOgBeoAJAAAAAAAAPUAPMAEAAAAAAKAH6AEmAAAAAAAA9AA9wAQAAAAAAIAeoAeYAAAAAAAA+O42CW9+2QTU+7QAAAAASUVORK5CYII=","normal":null,"emissive":null,"metallic":null,"roughness":null,"ao":null}}],"variants":[{"name":"Tall","overrides":{"columns":3,"height":4.5}},{"name":"Copper","overrides":{"columns":5,"finish":{"kind":"material","material":{"name":"Copper","baseColor":[0.95,0.55,0.32,1],"metallic":1,"roughness":0.25,"emissive":[0,0,0],"alphaMode":"OPAQUE","alphaCutoff":0.5,"textures":{"baseColor":null,"normal":null,"emissive":null,"metallic":null,"roughness":null,"ao":null}}},"tint":[0.35,0.75,0.6,1]}}]}